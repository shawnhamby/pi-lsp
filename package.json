{
	"name": "@shawnhamby/pi-lsp",
	"version": "0.1.0",
	"description": "Language Server Protocol tools and bounded inline diagnostics for Pi coding agents",
	"keywords": [
		"language-server",
		"lsp",
		"pi",
		"pi-package"
	],
	"homepage": "https://github.com/shawnhamby/pi-lsp#readme",
	"license": "MIT",
	"author": "Scott Spence <me@scottspence.com>",
	"contributors": [
		"Shawn Hamby"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/shawnhamby/pi-lsp.git"
	},
	"bugs": {
		"url": "https://github.com/shawnhamby/pi-lsp/issues"
	},
	"files": [
		"dist",
		"src",
		"README.md",
		"UPSTREAM.md",
		"LICENSE",
		"NOTICE.md"
	],
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"check": "tsc --noEmit -p tsconfig.json",
		"prepack": "pnpm run build",
		"test": "vitest run"
	},
	"dependencies": {
		"@spences10/pi-child-env": "0.1.10",
		"@spences10/pi-project-trust": "0.0.19",
		"@spences10/pi-tui-modal": "0.0.24"
	},
	"bundledDependencies": [
		"@spences10/pi-child-env",
		"@spences10/pi-project-trust",
		"@spences10/pi-tui-modal"
	],
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "0.84.0",
		"@types/node": "26.1.2",
		"typebox": "1.3.10",
		"typescript": "6.0.3",
		"vitest": "4.1.10"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"typebox": "*"
	},
	"engines": {
		"node": ">=24.15.0"
	},
	"packageManager": "pnpm@11.20.0",
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	}
}
